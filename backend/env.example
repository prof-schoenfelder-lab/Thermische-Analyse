# Kopieren nach /opt/thermo-backend/.env und Werte anpassen.
# Zufällige Secrets erzeugen mit:  python3 -c "import secrets; print(secrets.token_hex(32))"

# Öffentliche URL des Backends (inkl. Pfad-Präfix, ohne Slash am Ende)
BACKEND_URL=https://GUAC-HOST.htwk-leipzig.de/thermo

# signiert die Session-Tokens
SECRET_KEY=HIER-ZUFALLSWERT

# Salt für die Pseudonymisierung — einmal setzen, danach NIE ändern
# (sonst verlieren alle Studierenden die Zuordnung zu ihren Punkten)
USER_SALT=HIER-ZUFALLSWERT

# Ziel nach dem Login
SITE_URL=https://prof-schoenfelder-lab.github.io/Thermische-Analyse/

ALLOWED_ORIGINS=https://prof-schoenfelder-lab.github.io
DB_PATH=/opt/thermo-backend/data/results.db
PRIVATE_KEY_PATH=/opt/thermo-backend/data/lti_private.pem

# LTI 1.3 — Werte aus OPAL, Kursbaustein > Konfiguration > "Tool Konfiguration"
LTI13_ISSUER=https://bildungsportal.sachsen.de/opal
LTI13_AUTH_URL=https://bildungsportal.sachsen.de/opal/ltiauth/
LTI13_KEYSET_URL=https://bildungsportal.sachsen.de/opal/restapi/lti/keys
LTI13_DEPLOYMENT_ID=1
LTI13_TOKEN_URL=https://bildungsportal.sachsen.de/opal/restapi/lti/token
# Client ID: im OPAL-Kursbaustein eingetragener Wert
LTI13_CLIENT_ID=strukturmechanik-fem

# Noten-Rückkanal (AGS): 1 = Punkte als Bewertung an OPAL melden.
# Achtung: speichert die OPAL-Nutzer-ID verschlüsselt (nicht mehr strikt anonym).
AGS_ENABLED=1
